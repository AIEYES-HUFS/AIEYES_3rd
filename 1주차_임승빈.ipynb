예시: 데이터 [10, 20, 30]의 평균은 20이다.

원래 데이터        10   20   30
↓ 평균 제거       -10    0   10
↓ 표준편차로 나누기 → 표준화된 데이터
4.전체 구현 코드
python
import numpy as np
import pandas as pd

from sklearn.base import BaseEstimator, TransformerMixin
from sklearn.utils.validation import check_array, check_is_fitted


class StandardScalerClone(BaseEstimator, TransformerMixin):

    def __init__(self, with_mean=True):
        self.with_mean = with_mean

    def fit(self, X, y=None):
        if isinstance(X, pd.DataFrame):
            self.feature_names_in_ = np.array(X.columns)

        X = check_array(X)
        self.mean_ = X.mean(axis=0)
        self.scale_ = X.std(axis=0)
        self.n_features_in_ = X.shape[1]
        return self

    def transform(self, X):
        check_is_fitted(self)
        X = check_array(X)

        if X.shape[1] != self.n_features_in_:
            raise ValueError(
                f"Expected {self.n_features_in_} features, "
                f"but got {X.shape[1]}"
            )

        if self.with_mean:
            X = X - self.mean_
        return X / self.scale_

    def inverse_transform(self, X):
        check_is_fitted(self)
        X = check_array(X)

        if X.shape[1] != self.n_features_in_:
            raise ValueError(
                f"Expected {self.n_features_in_} features, "
                f"but got {X.shape[1]}"
            )

        X = X * self.scale_
        if self.with_mean:
            X = X + self.mean_
        return X

    def get_feature_names_out(self, input_features=None):
        check_is_fitted(self)

        if input_features is not None:
            input_features = np.asarray(input_features)

            if len(input_features) != self.n_features_in_:
                raise ValueError(
                    f"Expected {self.n_features_in_} feature names, "
                    f"but got {len(input_features)}"
                )

            if hasattr(self, "feature_names_in_"):
                if not np.array_equal(input_features, self.feature_names_in_):
                    raise ValueError(
                        "input_features does not match feature_names_in_"
                    )
            return input_features

        if hasattr(self, "feature_names_in_"):
            return self.feature_names_in_

        return np.array([f"x{i}" for i in range(self.n_features_in_)])
5.코드 해설
5.1 fit() — 학습 단계

fit()의 역할은 데이터를 변환하는 것이 아니라, 변환에 필요한 정보를 학습하는 것이다.

python
self.mean_ = X.mean(axis=0)
self.scale_ = X.std(axis=0)

각 column(feature)별로 평균과 표준편차를 개별적으로 계산해 저장한다.

n_features_in_의 역할

python
self.n_features_in_ = X.shape[1]

학습 시점에 입력된 feature 개수를 기억해 두는 값이다. 이후 transform() 호출 시 입력 feature 수가 다르면 오류를 발생시켜 잘못된 입력을 방지한다.

5.2 transform() — 변환 단계
python
if self.with_mean:
    X = X - self.mean_
return X / self.scale_

